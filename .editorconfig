root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# JSON stays at 4. composer normalize writes composer.json with a 4-space
# indent unconditionally, so a 2-space rule here would make an editor that
# honours this file turn `composer normalize --dry-run` red on save.
# pint.json matches composer.json for consistency.
[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
